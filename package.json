{
  "name": "songwunsch-vite",
  "version": "1.0.0",
  "private": true,
  "description": "Songwünsche per QR-Code für Simon Weichert – Vite + React + Hono, ohne Datenbank",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.7",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
