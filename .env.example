# Passwort für den Musiker-Bereich (/admin) – Pflicht
ADMIN_PASSWORD=bitte-aendern
# Optional: zusätzlicher geheimer Schlüssel für die Login-Cookies
SESSION_SECRET=

# Port des Servers (Produktion: hier läuft alles; Entwicklung: nur die API, Vite läuft auf 5173)
PORT=3001
# Ordner für songs.json und settings.json
DATA_DIR=data
# Nach wie vielen Stunden Wünsche spätestens gelöscht werden
REQUEST_TTL_HOURS=12
# true, wenn ein Reverse Proxy (z. B. Caddy, nginx) davor sitzt: dann gelten X-Forwarded-For/-Proto
TRUST_PROXY=false
